# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# --- Supabase ---
# From Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
# From Supabase project settings > Database > Connection string (Session mode)
DATABASE_URL=

# --- Gemini ---
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Microsoft Entra ID (Azure AD) SSO ---
# Configured in Supabase Auth > Providers > Azure
# Values go into Supabase dashboard, not here — but noted for reference:
# MS_ENTRA_TENANT_ID=
# MS_ENTRA_CLIENT_ID=
# MS_ENTRA_CLIENT_SECRET=

# --- Authentication (OpenID Connect) ---
# Works with any OIDC provider. For Microsoft Entra ID the issuer is
#   https://login.microsoftonline.com/<tenant-id>/v2.0
# Register the redirect URI  <AUTH_URL>/api/auth/callback  with the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Random string, 32+ characters — signs the session cookie.
AUTH_SECRET=
# This app's base URL. Optional; inferred from the request when unset.
AUTH_URL=
