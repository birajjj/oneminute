// OneMinute Cloud database schema.
// Every table has org_id so Row Level Security can filter cross-org data.
// Follow the semantic model of the on-prem OneMinute (see CLAUDE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------------------------------
// Tenancy
// --------------------------------------------------------------

model Org {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")

  users       User[]
  projects    Project[]
  meetings    Meeting[]
  minutes     Minute[]
  areas       MeetingArea[]
  audit       AuditLog[]
  attachments Attachment[]

  @@map("orgs")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  email         String    @unique
  displayName   String    @map("display_name")
  entraObjectId String?   @unique @map("entra_object_id") // Microsoft Entra OID
  // true = a team member you can assign work to (reference roster);
  // false = a login account. Keeps the assignee dropdown clean.
  isRoster      Boolean   @default(false) @map("is_roster")
  createdAt     DateTime  @default(now()) @map("created_at")

  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meetingsOwned Meeting[] @relation("meeting_owner")
  minutesOwned  Minute[]  @relation("minute_assignee")

  @@index([orgId])
  @@map("users")
}

// --------------------------------------------------------------
// Core domain
// --------------------------------------------------------------

model Project {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  name      String
  ownerName String?   @map("owner_name")
  createdAt DateTime  @default(now()) @map("created_at")

  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meetings  Meeting[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("projects")
}

model Meeting {
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  projectId         String        @map("project_id") @db.Uuid

  title             String
  description       String?
  meetingDate       DateTime      @map("meeting_date")
  attendee          String?
  ownerUserId       String?       @map("owner_user_id") @db.Uuid

  // follow-up semantics from on-prem OneMinute:
  //   parentMeetingId = null       → standalone meeting; auto-create "General" area
  //   parentMeetingId = "*ALL*"    → project-wide followup; copy areas from all prior project meetings
  //   parentMeetingId = <id>       → followup to a specific meeting; copy areas from that meeting
  parentMeetingIdRaw String?      @map("parent_meeting_id_raw")

  // Verbatim record of what was said, kept with the meeting it produced so it
  // can be downloaded later and compared against the minutes (AI Recommendation).
  transcript        String?

  // list of parent-minute ids that were "marked complete" during this meeting (mirrors MeetingMinuteID)
  completedParentMinuteIds String[] @map("completed_parent_minute_ids") @db.Uuid

  createdAt         DateTime      @default(now()) @map("created_at")

  org               Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerUser         User?         @relation("meeting_owner", fields: [ownerUserId], references: [id])

  minutes           Minute[]
  areas             MeetingArea[]
  attachments       Attachment[]

  @@index([orgId])
  @@index([projectId])
  @@map("meetings")
}

// A document uploaded against a meeting. The file bytes live in the DB (bytea)
// per the "just store it in the database" requirement — keep uploads small.
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  meetingId    String   @map("meeting_id") @db.Uuid
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  size         Int
  data         Bytes
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("attachments")
}

model MeetingArea {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  meetingId    String   @map("meeting_id") @db.Uuid

  areaName     String   @map("area_name")
  createdOnFly Boolean  @default(false) @map("created_on_fly")

  createdAt    DateTime @default(now()) @map("created_at")

  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, areaName])
  @@index([orgId])
  @@map("meeting_areas")
}

enum MinuteType {
  Note
  Todo    @map("To-Do")
  Action
  Devops
}

enum MinuteStatus {
  New
  Initiated
  InProgress  @map("In Progress")
  Resolved
  // Displayed as "Closed" in the UI. Kept as the DB value `Completed` so we only
  // ADD an enum value (safe) rather than rename one (a destructive migration).
  // Resolved carries into follow-ups; Completed/Closed and Cancelled do not.
  Completed
  Cancelled
}

model Minute {
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  meetingId         String        @map("meeting_id") @db.Uuid

  area              String        @default("General")
  title             String
  description       String?
  type              MinuteType    @default(Note)
  status            MinuteStatus  @default(New)

  // Governance flags (on-prem: a comma-joined `Tags` string). A real array so a
  // minute can carry several and they can be filtered on — see lib/tags.ts.
  tags              String[]      @default([])

  // follow-up chain: null means new minute, set means this updates that parent minute
  parentMinuteId    String?       @map("parent_minute_id") @db.Uuid

  // Provenance: a brand-new minute (its own root/thread) that was raised while
  // reviewing another open item in a follow-up. It is independently trackable,
  // but Browse groups it under that item in the meeting it was raised.
  raisedFromRootId  String?       @map("raised_from_root_id") @db.Uuid

  // when true, this minute persists into follow-up meetings until Completed (was `MinuteType='Standalone'`)
  isPersistent      Boolean       @default(false) @map("is_persistent")

  assignedToUserId  String?       @map("assigned_to_user_id") @db.Uuid
  dueDate           DateTime?     @map("due_date")

  devopsItemId      Int?          @map("devops_item_id")
  devopsArea        String?       @map("devops_area")

  remarks           String?
  createdOnFly      Boolean       @default(false) @map("created_on_fly")

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  org               Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting           Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  parentMinute      Minute?       @relation("minute_followups", fields: [parentMinuteId], references: [id])
  followUps         Minute[]      @relation("minute_followups")
  raisedFromRoot    Minute?       @relation("minute_raised_from", fields: [raisedFromRootId], references: [id])
  raisedItems       Minute[]      @relation("minute_raised_from")
  assignedTo        User?         @relation("minute_assignee", fields: [assignedToUserId], references: [id])

  @@index([orgId])
  @@index([meetingId])
  @@index([parentMinuteId])
  @@map("minutes")
}

// --------------------------------------------------------------
// Audit log — every mutation lands here
// --------------------------------------------------------------

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  orgId     String   @map("org_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  tableName String   @map("table_name")
  rowId     String   @map("row_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([tableName, rowId])
  @@map("audit_log")
}

// --------------------------------------------------------------
// Analysis jobs — async AI analysis so a long transcript is processed in
// <60s segments (Vercel Hobby caps a function at 60s). The transcript is saved
// here, then analysed one segment per request; each step advances segmentsDone
// and re-triggers the next until done, so it finishes even if the tab closes.
// Isolation is app-layer via orgId (like every other table); runToken lets the
// server-to-server "next segment" trigger authenticate without a user session.
// --------------------------------------------------------------

model AnalysisJob {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid

  kind          String    // "auto" | "followup"
  status        String    @default("queued") // queued | running | done | error

  transcript    String
  params        Json?     // kind-specific inputs: { today } | { parentMeetingId }

  segmentsTotal Int       @default(1) @map("segments_total")
  segmentsDone  Int       @default(0) @map("segments_done")

  result        Json?     // accumulated plan (AutoPlan | FollowUpPlan)
  error         String?

  runToken      String    @map("run_token") // shared secret for the self-trigger chain
  lockedAt      DateTime? @map("locked_at")  // set while a segment is processing (stale after 90s)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([orgId, createdAt])
  @@index([status])
  @@map("analysis_jobs")
}
